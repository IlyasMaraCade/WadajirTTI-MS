# ================================================================
# Wadajir Institute Backend - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ================================================================

# Application
NODE_ENV=production
PORT=5000

# MongoDB Atlas
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/wadajir_institute_db?retryWrites=true&w=majority

# JWT Secrets - minimum 32 characters, use strong random strings
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=replace_with_strong_random_secret_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_another_strong_random_secret_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS - set to your deployed frontend URL in production
CORS_ORIGIN=https://your-frontend-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
